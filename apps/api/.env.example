# Connexion directe à la base Postgres de votre projet Supabase
# (Project Settings > Database > Connection string > URI, mode "Transaction pooler" recommandé)
DATABASE_URL=postgresql://postgres:xxxx@db.xxxxxxxx.supabase.co:5432/postgres

# Project Settings > API > JWT Settings > JWT Secret (sert à vérifier les tokens émis par Supabase Auth)
SUPABASE_JWT_SECRET=xxxxxxxx

# Origine(s) autorisée(s) à appeler l'API (le frontend Next.js), séparées par des virgules
WEB_ORIGIN=http://localhost:3000

PORT=4000
NODE_ENV=development

# À définir (n'importe quelle valeur) uniquement en production, derrière un
# reverse proxy (Render, Railway, Fly.io, nginx...), pour que le rate limiting
# et req.ip lisent la vraie IP du client.
# TRUST_PROXY=1

# Requis uniquement par le script `npm run create-admin` (jamais exposé au navigateur)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
