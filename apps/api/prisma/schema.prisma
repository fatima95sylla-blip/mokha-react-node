// Prisma se connecte DIRECTEMENT à la base Postgres de votre projet Supabase
// (Project Settings > Database > Connection string). Supabase reste responsable
// de l'authentification (auth.users) et du storage (fichiers/images) ; Prisma/Express
// gèrent toute la logique métier (catalogue, panier, commandes, sur-mesure...).
//
// Les tables sont créées par supabase/migrations/0001_init.sql (exécutée dans le
// SQL Editor de Supabase ou via `supabase db push`). Ce schéma sert de couche de
// typage/accès pour l'API Node — il ne recrée pas les migrations (pas de
// `prisma migrate dev` en production, seulement `prisma db pull` si le schéma
// Supabase évolue côté SQL en premier).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  email     String
  fullName  String?  @map("full_name")
  phone     String?
  role      String   @default("client")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  addresses      Address[]
  wishlists      Wishlist[]
  carts          Cart[]
  orders         Order[]
  customRequests CustomRequest[]
  measurements   Measurement[]
  notifications  Notification[]

  @@map("profiles")
}

model Address {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  label     String  @default("Domicile")
  fullName  String  @map("full_name")
  phone     String
  line1     String
  line2     String?
  city      String
  country   String  @default("Sénégal")
  isDefault Boolean @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  nom         String
  description String?
  ordre       Int       @default(0)
  products    Product[]

  @@map("categories")
}

model Collection {
  id          String    @id @default(uuid())
  slug        String    @unique
  nom         String
  saison      String?
  accroche    String?
  description String?
  imageUrl    String?   @map("image_url")
  publiee     Boolean   @default(true)
  ordre       Int       @default(0)
  products    Product[]

  @@map("collections")
}

model Product {
  id                  String   @id @default(uuid())
  slug                String   @unique
  nom                 String
  reference           String   @unique
  description         String?
  matiere             String?
  entretien           String?
  delai               String?
  confection          String?
  prix                Decimal  @db.Decimal(12, 2)
  categoryId          String?  @map("category_id")
  collectionId        String?  @map("collection_id")
  disponibilite       String   @default("En stock")
  surMesureDisponible Boolean  @default(false) @map("sur_mesure_disponible")
  nouveaute           Boolean  @default(false)
  populaire           Int      @default(0)
  publie              Boolean  @default(true)

  category   Category?         @relation(fields: [categoryId], references: [id])
  collection Collection?       @relation(fields: [collectionId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  ordre     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Size {
  id       String           @id @default(uuid())
  label    String           @unique
  ordre    Int              @default(0)
  variants ProductVariant[]

  @@map("sizes")
}

model Color {
  id       String           @id @default(uuid())
  label    String           @unique
  hex      String?
  variants ProductVariant[]

  @@map("colors")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  sizeId       String?  @map("size_id")
  colorId      String?  @map("color_id")
  sku          String   @unique
  stock        Int      @default(0)
  prixOverride Decimal? @map("prix_override") @db.Decimal(12, 2)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       Size?       @relation(fields: [sizeId], references: [id])
  color      Color?      @relation(fields: [colorId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

model Wishlist {
  id        String @id @default(uuid())
  profileId String @map("profile_id")
  productId String @map("product_id")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("wishlists")
}

model Cart {
  id        String   @id @default(uuid())
  profileId String?  @map("profile_id")
  sessionId String?  @map("session_id")
  devise    String   @default("XOF")

  profile Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String @map("cart_id")
  variantId String @map("variant_id")
  mode      String @default("pret-a-porter")
  quantite  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

model Order {
  id                String   @id @default(uuid())
  numero            String   @unique
  profileId         String?  @map("profile_id")
  statut            String   @default("nouvelle")
  sousTotal         Decimal  @default(0) @map("sous_total") @db.Decimal(12, 2)
  fraisLivraison    Decimal  @default(0) @map("frais_livraison") @db.Decimal(12, 2)
  total             Decimal  @default(0) @db.Decimal(12, 2)
  devise            String   @default("XOF")
  adresseLivraison  Json     @map("adresse_livraison")
  contactEmail      String   @map("contact_email")
  contactPhone      String   @map("contact_phone")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  profile  Profile?    @relation(fields: [profileId], references: [id])
  items    OrderItem[]
  payments Payment[]
  delivery Delivery?

  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  variantId     String? @map("variant_id")
  nomProduit    String  @map("nom_produit")
  taille        String?
  couleur       String?
  mode          String  @default("pret-a-porter")
  quantite      Int
  prixUnitaire  Decimal @map("prix_unitaire") @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                 String   @id @default(uuid())
  orderId            String   @map("order_id")
  provider           String
  providerReference  String?  @map("provider_reference")
  statut             String   @default("en_attente")
  montant            Decimal  @db.Decimal(12, 2)
  devise             String   @default("XOF")
  payload            Json?
  createdAt          DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Delivery {
  id              String    @id @default(uuid())
  orderId         String    @unique @map("order_id")
  transporteur    String?
  numeroSuivi     String?   @map("numero_suivi")
  statut          String    @default("en_attente")
  dateExpedition  DateTime? @map("date_expedition")
  dateLivraison   DateTime? @map("date_livraison")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

model CustomRequest {
  id              String   @id @default(uuid())
  numero          String   @unique
  profileId       String?  @map("profile_id")
  nom             String
  telephone       String
  email           String
  typeVetement    String   @map("type_vetement")
  occasion        String?
  couleurs        String?
  tissu           String?
  description     String?
  budgetIndicatif String?  @map("budget_indicatif")
  dateSouhaitee   DateTime? @map("date_souhaitee")
  inspirations    String?
  mesures         Json?
  statut          String   @default("nouvelle")
  notesInternes   String?  @map("notes_internes")
  createdAt       DateTime @default(now()) @map("created_at")

  profile Profile?               @relation(fields: [profileId], references: [id])
  images  CustomRequestImage[]

  @@map("custom_requests")
}

model CustomRequestImage {
  id              String @id @default(uuid())
  customRequestId String @map("custom_request_id")
  url             String
  ordre           Int    @default(0)

  request CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@map("custom_request_images")
}

model Measurement {
  id              String   @id @default(uuid())
  profileId       String?  @map("profile_id")
  nom             String   @default("Mes mesures")
  poitrine        Decimal? @db.Decimal(6, 2)
  taille          Decimal? @db.Decimal(6, 2)
  hanches         Decimal? @db.Decimal(6, 2)
  epaules         Decimal? @db.Decimal(6, 2)
  longueurManche  Decimal? @map("longueur_manche") @db.Decimal(6, 2)
  longueurRobe    Decimal? @map("longueur_robe") @db.Decimal(6, 2)
  autres          Json?

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model BlogCategory {
  id    String     @id @default(uuid())
  slug  String     @unique
  nom   String
  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id         String    @id @default(uuid())
  slug       String    @unique
  titre      String
  extrait    String?
  contenu    String?
  imageUrl   String?   @map("image_url")
  categoryId String?   @map("category_id")
  statut     String    @default("brouillon")
  publieLe   DateTime? @map("publie_le")

  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model Service {
  id          String  @id @default(uuid())
  slug        String  @unique
  nom         String
  description String?
  imageUrl    String? @map("image_url")
  ordre       Int     @default(0)
  actif       Boolean @default(true)

  @@map("services")
}

model Faq {
  id        String  @id @default(uuid())
  question  String
  reponse   String
  categorie String?
  ordre     Int     @default(0)
  publie    Boolean @default(true)

  @@map("faqs")
}

model Media {
  id       String  @id @default(uuid())
  url      String
  nom      String?
  alt      String?

  @@map("media")
}

model Notification {
  id        String   @id @default(uuid())
  profileId String?  @map("profile_id")
  titre     String
  message   String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("settings")
}
