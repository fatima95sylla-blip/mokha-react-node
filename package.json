{
  "name": "mokha-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web-vite",
    "dev:api": "mvn -f apps/backend/pom.xml spring-boot:run",
    "build:web": "npm run build --workspace=apps/web-vite",
    "build:api": "mvn -f apps/backend/pom.xml test"
  }
}
